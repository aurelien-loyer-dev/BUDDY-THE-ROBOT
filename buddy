#!/usr/bin/env bash
# Pilotage de Buddy depuis le Mac : ./buddy deploy|restart|logs|status|screen
# IP du robot : buddy.ip=<ip> dans local.properties (ou variable BUDDY_IP).
set -euo pipefail
cd "$(dirname "$0")"

PKG=com.example.buddyug
PORT=8080
IP="${BUDDY_IP:-$(sed -n 's/^buddy\.ip=//p' local.properties 2>/dev/null | tr -d '[:space:]')}"
[ -n "$IP" ] || { echo "IP de Buddy inconnue : ajoute buddy.ip=<ip> dans local.properties (ou BUDDY_IP=<ip> ./buddy ...)"; exit 1; }
DEV="$IP:5555"
URL="http://$IP:$PORT/"

connect() {
  # Déjà connecté côté ADB : rien à faire (pas de sonde réseau, qui peut échouer
  # à tort quand le WiFi du robot est lent à accepter une nouvelle connexion).
  [ "$(adb -s "$DEV" get-state 2>/dev/null)" = device ] && return 0
  # Sinon, test du port d'abord : `adb connect` vers une IP morte bloque ~75 s.
  # (sur macOS, seul -G borne la connexion ; -w ne la borne que sous Linux)
  if [ "$(uname)" = Darwin ]; then t=(-G 8); else t=(-w 8); fi
  nc -z "${t[@]}" "$IP" 5555 2>/dev/null || { echo "Buddy injoignable sur $DEV (même WiFi ? robot allumé ? ADB WiFi actif ?)"; exit 1; }
  adb connect "$DEV" >/dev/null 2>&1 || true
  adb -s "$DEV" get-state >/dev/null 2>&1 || { echo "Buddy injoignable sur $DEV (même WiFi ? ADB WiFi actif ?)"; exit 1; }
}

wait_ready() {
  printf "Attente de l'app"
  for _ in $(seq 1 60); do # ~5 min max
    if curl -s -m 3 -o /dev/null "$URL"; then echo " : prête → $URL"; return 0; fi
    adb connect "$DEV" >/dev/null 2>&1 || true
    printf "."; sleep 5
  done
  echo; echo "L'app ne répond pas sur $URL : regarde ./buddy logs"; exit 1
}

# Relance l'app sans redémarrer le robot. Un `am start` direct de MainActivity
# est refusé par BuddyCore ("restarted by companion") : on passe par le relais
# exporté du Companion (com.bfr.buddy.utils.ActivityLauncher), comme au boot.
# Le Companion crée alors sa mission et donne le focus à l'app (~1 s).
restart() {
  connect
  echo "Relance de l'app..."
  adb -s "$DEV" shell am force-stop "$PKG"
  adb -s "$DEV" shell am start -n com.bfr.buddy.companion/com.bfr.buddy.utils.ActivityLauncher \
    --es ActivityResultTracker_packageName_to_launch "$PKG" \
    --es ActivityResultTracker_activityName_to_launch "$PKG.MainActivity" \
    --ez ActivityResultTracker_should_launch_with_isLockTask false >/dev/null
  wait_ready
}

# Redémarrage complet du robot (l'app repart via Autostart: true).
# Attention : sur batterie, Buddy s'est déjà éteint au lieu de redémarrer.
reboot_robot() {
  connect
  echo "Redémarrage de Buddy (laisse-le branché sur secteur)..."
  adb -s "$DEV" reboot
  sleep 15 # laisse le serveur de l'ancienne instance tomber avant d'attendre le nouveau
  wait_ready
}

open_screen() {
  if command -v open >/dev/null; then open "$URL"; else xdg-open "$URL"; fi
}

case "${1:-}" in
  deploy)
    connect
    (cd display && { [ -d node_modules ] || npm install; } && npm run android)
    ./gradlew installDebug -q
    restart
    open_screen
    ;;
  restart) restart ;;
  reboot) reboot_robot ;;
  logs)
    connect
    adb -s "$DEV" logcat -s 'BuddyUG:*' 'AndroidRuntime:E'
    ;;
  status)
    connect
    echo "Robot   : connecté ($DEV)"
    pid=$(adb -s "$DEV" shell pidof "$PKG" | tr -d '\r' || true)
    if [ -n "$pid" ]; then echo "App     : lancée (pid $pid)"; else echo "App     : arrêtée"; fi
    code=$(curl -s -m 3 -o /dev/null -w '%{http_code}' "$URL" || true)
    [ "$code" = 200 ] && echo "Écran   : OK → $URL" || echo "Écran   : injoignable ($URL)"
    ;;
  screen) open_screen ;;
  *)
    cat <<EOF
Usage : ./buddy <commande>
  deploy   build écran + APK, installe, relance l'app, ouvre l'écran
  restart  relance l'app (sans redémarrer le robot) et attend qu'elle soit prête
  reboot   redémarre tout le robot (à garder pour les cas bloqués, sur secteur)
  logs     logs de l'app en direct (Ctrl+C pour quitter)
  status   robot connecté ? app lancée ? écran joignable ?
  screen   ouvre $URL
EOF
    ;;
esac
